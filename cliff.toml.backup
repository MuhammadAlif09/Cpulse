[changelog]
header = """
# Changelog\n
All notable changes to this project will be documented in this file.\n
The format is based on [Keep a Changelog](https://keepachangelog.com/en/1.0.0/),
and this project adheres to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).\n
"""
body = """
{% if version %}\
    ## [{{ version | trim_start_matches(pat="v") }}] - {{ timestamp | date(format="%Y-%m-%d") }}
{% else %}\
    ## [Unreleased]
{% endif %}\
{% for group, commits in commits | group_by(attribute="group") %}
    ### {{ group | upper_first }}
    {% for commit in commits %}
        - {{ commit.message | upper_first }}\
    {% endfor %}
{% endfor %}\n
"""
trim = true
footer = ""

[git]
conventional_commits = true
filter_unconventional = false
split_commits = false
commit_parsers = [
  { message = "^feat", group = "Added" },
  { message = "^fix", group = "Fixed" },
  { message = "^docs", group = "Documentation" },
  { message = "^style", group = "Styling" },
  { message = "^refactor", group = "Changed" },
  { message = "^perf", group = "Performance" },
  { message = "^test", group = "Testing" },
  { message = "^chore\\(release\\)", skip = true },
  { message = "^chore", group = "Miscellaneous" },
  { message = "^ci", group = "CI/CD" },
  { message = "^build", group = "Build" },
  { message = "^revert", group = "Reverted" },
  { message = "^Phase", group = "Added" },
  { message = "^Initial commit", group = "Added" },
  { message = "^Add ", group = "Added" },
  { message = "^Fix ", group = "Fixed" },
  { message = "^Update ", group = "Changed" },
  { message = "^Apply ", group = "Changed" },
  { message = "^Sync ", group = "Changed" },
  { message = "^Change ", group = "Changed" },
  { message = "^Clean up", group = "Changed" },
  { message = "^Connect", group = "Added" },
  { message = "^Custom", group = "Added" },
  { message = "^Integrate", group = "Added" },
  { message = "^Disable", group = "Fixed" },
  { message = "^Pass ", group = "Fixed" },
  { message = "^Upgrade", group = "Documentation" },
  { message = "^Match ", group = "Documentation" },
  { message = ".*", group = "Other" },
]
filter_commits = false
tag_pattern = "v[0-9]*"
ignore_tags = ""
topo_order = false
sort_commits = "oldest"
